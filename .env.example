# Copy to .env.local (local) and add the same vars in Vercel → Environment Variables (production).

# Web3Forms – booking emails (required). Get key at https://web3forms.com
# Must be NEXT_PUBLIC_ so the browser can send (same as Web3Forms sample code).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# Optional: 2+ more inboxes – create one Web3Forms form per email, comma-separate the extra keys:
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY_EXTRA=second-form-key,third-form-key

# Optional legacy FormSubmit fallback (often unreliable):
# NEXT_PUBLIC_FORMSUBMIT_EMAIL=your-email@example.com

# Optional Supabase (prevents double-booking):
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: CRON_SECRET for /api/keepalive
