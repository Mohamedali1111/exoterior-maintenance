# Copy this file to .env.local and fill in your values. Do not commit .env.local.

# ── Booking email (pick at least one) ─────────────────────────────────────────

# RECOMMENDED: Web3Forms – reliable, free, works from your server (not the browser).
# 1. Go to https://web3forms.com → create a form → use your Gmail as recipient.
# 2. Copy the Access Key and paste it here:
# WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# Optional legacy: FormSubmit (often slow/down). Browser + server may both fail when their site is down.
# NEXT_PUBLIC_FORMSUBMIT_EMAIL=your-email@example.com
# NEXT_PUBLIC_FORMSUBMIT_EMAIL_SECONDARY=second@example.com
# NEXT_PUBLIC_FORMSUBMIT_EMAIL_EXTRA=extra1@example.com,extra2@example.com

# ── Supabase (optional – prevents double-booking) ───────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: secret for /api/keepalive. See README "Keep Supabase active".
# CRON_SECRET=your-random-secret
